{
  "config": {
    "step": {
      "user": {
        "title": "Connect to Whisker Ting",
        "description": "Enter your Whisker Ting account credentials. These are the same credentials you use in the Ting app.",
        "data": {
          "username": "Email",
          "password": "Password"
        }
      },
      "reauth_confirm": {
        "title": "Reauthenticate with Whisker Ting",
        "description": "Your authentication has expired. Please enter your credentials to restore the connection.",
        "data": {
          "username": "Email",
          "password": "Password"
        }
      }
    },
    "error": {
      "invalid_auth": "Invalid email or password",
      "cannot_connect": "Unable to connect to Whisker Ting API",
      "unknown": "An unknown error occurred"
    },
    "abort": {
      "already_configured": "This account is already configured",
      "reauth_successful": "Reauthentication successful"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Configure Whisker Ting",
        "data": {
          "scan_interval": "Update interval (seconds)"
        },
        "data_description": {
          "scan_interval": "How often to poll the Whisker Ting API for updates (30-3600 seconds)"
        }
      }
    }
  },
  "issues": {
    "reauthentication_required": {
      "title": "Whisker Ting authentication expired",
      "description": "Home Assistant could no longer renew credentials for {entry_title} and has started reauthentication. Open **Settings > Devices & services**, select the Whisker Ting integration, and complete the reauthentication prompt."
    },
    "stream_unavailable": {
      "title": "Ting real-time stream is unavailable",
      "description": "REST updates for {device_name} are succeeding, but its real-time SignalR stream has remained unavailable across several updates. Check network access to Ting and reload the integration after connectivity is restored. This issue clears automatically when the stream recovers."
    },
    "device_offline": {
      "title": "Ting device is persistently offline",
      "description": "Ting has reported {device_name} offline across several updates. Check power and network connectivity for the Ting sensor. This issue clears automatically after Ting reports the device online."
    },
    "live_samples_missing": {
      "title": "Ting live samples are missing",
      "description": "The stream for {device_name} is connected or reconnecting but has not produced a valid voltage, frequency, or THD sample across several updates. This issue clears automatically after a valid sample arrives."
    },
    "optional_capability_unauthorized": {
      "title": "Ting optional capability is no longer authorized",
      "description": "Ting explicitly denied access to {capability} for {entry_title}. Other integration features continue to work. Unsupported endpoints and temporary service failures do not create this repair. The issue clears automatically if access succeeds later."
    },
    "optional_capability_unavailable": {
      "title": "Ting optional capability is temporarily unavailable",
      "description": "The {capability} capability for {entry_title} has failed across several updates because the {reason}. Other integration features continue to work. This issue clears automatically when the capability recovers."
    }
  },
  "services": {
    "import_voltage_history": {
      "name": "Import voltage history",
      "description": "Import a bounded Ting voltage-history window into long-term statistics.",
      "fields": {
        "config_entry_id": {
          "name": "Config entry ID",
          "description": "Loaded Whisker Ting config entry."
        },
        "serial_number": {
          "name": "Serial number",
          "description": "Ting device serial number belonging to the selected entry."
        },
        "start": {
          "name": "Start",
          "description": "Inclusive start with timezone; at most 31 days before the end."
        },
        "end": {
          "name": "End",
          "description": "Exclusive end with timezone."
        }
      }
    }
  },
